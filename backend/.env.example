# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Clave secreta para firma criptográfica de entradas QR (HMAC SHA-256)
QR_SECRET_KEY=clave_ultra_secreta_productoras_2026_cibersegura_987654321

# Motor de Base de Datos:
# Si se deja vacío DATABASE_URL, el sistema usa SQLite automáticamente (ideal para desarrollo sin configurar nada).
# Si se define DATABASE_URL con postgresql://..., se conectará a PostgreSQL.
# DATABASE_URL=postgresql://usuario:password@localhost:5432/eventos_db

# Configuración de Servidor de Correo (SMTP)
# En desarrollo, si no configuras SMTP, el sistema simula el envío y muestra la URL/vista previa en consola.
SMTP_HOST=smtp.ejemplo.cl
SMTP_PORT=587
SMTP_USER=tickets@productora.cl
SMTP_PASS=tu_password_smtp_segura
SMTP_FROM_EMAIL=tickets@productora.cl
